# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server-side secret ONLY. Never put this in Vercel or VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Comma-separated frontend origins allowed to call the API.
# Keep localhost for local testing, then add the Vercel production URL.
FRONTEND_URL=http://localhost:5173

PORT=8787

# OPTIONAL: Real emergency SMS delivery.
# If these are blank, We-Rise will NEVER claim SMS was sent; the UI will show ready-to-send SMS links instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# SAFETY GATE: keep false until the emergency flow and provider delivery are fully tested in production.
ENABLE_EMERGENCY_SMS=false

# PayFast starts in sandbox and remains disabled until the merchant credentials
# and the public Render callback URL have been tested end to end.
PAYFAST_MODE=sandbox
ENABLE_PAYFAST=false
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
API_PUBLIC_URL=http://localhost:8787

# Optional comma-separated exact IP list. Leave blank unless PayFast supplies a
# current allowlist; signature and server confirmation are always still required.
PAYFAST_IP_ALLOWLIST=

# Keep voluntary BackMi gifts disabled until PayFast approves the proposed
# third-party gift/fund flow and the final payout model is agreed.
ENABLE_BACKMI_PAYMENTS=false

# Server-side roles. These accounts do not appear in the public member directory.
WE_RISE_ADMIN_EMAILS=
BACKMI_REVIEWER_EMAILS=

# Direct We-Rise support email. For Gmail, enable two-step verification on the
# support mailbox and use a Google App Password here, never the normal password.
SUPPORT_TO_EMAIL=request4.support@gmail.com
SUPPORT_EMAIL_ENABLED=false
SUPPORT_FROM_EMAIL=request4.support@gmail.com
SUPPORT_FROM_NAME=We-Rise Support
BREVO_API_KEY=
