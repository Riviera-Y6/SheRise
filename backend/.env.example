# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server-side secret ONLY. Never put this in Vercel or VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Comma-separated frontend origins allowed to call the API.
# Keep localhost for local testing, then add the Vercel production URL.
FRONTEND_URL=http://localhost:5173

PORT=8787
